# Cloudflare R2 S3-Compatible Storage Configuration for rclone
# Active configuration file: /root/.config/rclone/rclone.conf (chmod 600, owned by root:root)

[r2]
type = s3
provider = Cloudflare
access_key_id = YOUR_CLOUDFLARE_R2_ACCESS_KEY_ID
secret_access_key = YOUR_CLOUDFLARE_R2_SECRET_ACCESS_KEY
endpoint = https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
acl = private
no_check_bucket = true
