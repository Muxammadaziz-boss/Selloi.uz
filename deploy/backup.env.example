# Selloi Production Automated Backup Configuration Template
# Store active configuration at: /etc/selloi/backup.env (chmod 400, owned by root:root)

# Local backup directory (chmod 700)
BACKUP_DIR="/var/backups/selloi"

# AES-256-GCM symmetric key location (chmod 400, owned by root:root)
KEY_PATH="/etc/selloi/backup.key"

# Log file destination
LOG_FILE="/var/log/selloi_backup.log"

# Target PostgreSQL container & database settings
DB_CONTAINER="telegram_ai_seller-db-1"
DB_USER="sales"
DB_NAME="aisales"

# Persistent storage directory
STORAGE_SRC="/home/ubuntu/projects/Telegram_Ai_Seller/storage"

# Cloudflare R2 rclone destination
RCLONE_REMOTE="r2:selloi-backups/daily"

# Retention settings
RETENTION_DAYS=30
MIN_RETAINED_BACKUPS=2

# Telegram failure notification credentials
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
