# ==============================================================================
# Selloi Backup System Environment Configuration Example
# Strict permission requirements: mode 0600 (owner read/write only)
# Never commit actual credentials to version control.
# ==============================================================================

# Supabase Production Database (Direct connection or session pooler, Port 5432)
# Notice: Do NOT use transaction-pooling port 6543 for pg_dump
BACKUP_DATABASE_URL=postgresql://postgres.ganlawuubihxinuwjvez:YOUR_STRONG_PASSWORD@aws-1-eu-west-3.pooler.supabase.com:5432/postgres

# Master Encryption Key Location (Mode 0400, root only)
BACKUP_ENCRYPTION_KEY_FILE=/etc/selloi/selloi_backup.key

# VPS Media Directory
BACKUP_MEDIA_DIR=/opt/telegram_ai_seller/storage/channel_images

# Destination 1: Local VPS Encrypted Archive
BACKUP_LOCAL_ENABLED=true
BACKUP_LOCAL_DIR=/var/backups/selloi

# Destination 2: Cloudflare R2 (Supports either R2_* standard or BACKUP_R2_* legacy format)
BACKUP_R2_ENABLED=true
R2_ENDPOINT_URL=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=selloi-backups
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Legacy aliases supported:
# BACKUP_R2_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# BACKUP_R2_BUCKET=selloi-backups
# BACKUP_R2_ACCESS_KEY=your_r2_access_key_id
# BACKUP_R2_SECRET_KEY=your_r2_secret_access_key

# Destination 3: Google Drive (Supports either GDRIVE_* standard or BACKUP_GDRIVE_* legacy format)
BACKUP_GDRIVE_ENABLED=true
GDRIVE_FOLDER_ID=your_gdrive_folder_id
GDRIVE_SERVICE_ACCOUNT_JSON=/etc/selloi/gdrive_service_account.json
# Legacy aliases supported:
# BACKUP_GDRIVE_FOLDER_ID=your_gdrive_folder_id
# BACKUP_GDRIVE_SERVICE_ACCOUNT_JSON=/etc/selloi/gdrive_service_account.json

# Telegram Failure & Success Notifications
BACKUP_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
BACKUP_TELEGRAM_CHAT_ID=-1001234567890
